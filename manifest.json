{
  "manifest_version": 3,
  "name": "MxM Studio Correction Pad",
  "version": "1.5.0",
  "description": "Correction Pad with high-contrast Blue/Gold theme. Batch find and replace tool for Musixmatch Studio.",
  "author": "Richard Mangezi Muketa",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://curators.musixmatch.com/*",
    "https://curators-beta.musixmatch.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mxm-correction-pad@richie.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://curators.musixmatch.com/*",
        "https://curators-beta.musixmatch.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
